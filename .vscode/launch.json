    "version": "0.2.0",
    "configurations": [
        {
            "name": "help",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "main.go",
            "args": [
                "-h",
            ]
        },
        {
            "name": "version",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "main.go",
            "args": [
                "-v"
            ]
        },
        {
            "name": "version dist/windows-amd64/m2h.exe",
            "type": "go",
            "request": "launch",
            "mode": "exec",
            "program": "${workspaceFolder}/dist/windows-amd64/m2h.exe",
            "args": [
                "-v"
            ]
        },
        {
            "name": "windows-amd64/m2h.exe test/test.md",
            "type": "node-terminal",
            "request": "launch",
            "command": "${workspaceFolder}/dist/windows-amd64/m2h.exe test/test.md > ${workspaceFolder}/test/test.htm; exit $LASTEXITCODE",
            "cwd": "${workspaceFolder}"
        }
    ]
}